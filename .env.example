# OpenSec Studio - Wireless Security Platform
# Copy this file to .env and replace all placeholder values before starting.
# NEVER commit .env with real credentials.

# Environment: development | production
OPENSEC_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# Control Plane API & Web
OPENSEC_API_HOST=0.0.0.0
OPENSEC_API_PORT=8080
OPENSEC_WEB_PORT=8088
OPENSEC_JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_SECRET
OPENSEC_JWT_TTL_SECONDS=3600

# PostgreSQL (Internal network only in production)
POSTGRES_DB=opensec
POSTGRES_USER=opensec_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgres://opensec_app:CHANGE_ME_STRONG_POSTGRES_PASSWORD@opensec-postgres:5432/opensec

# Redis (Internal network only, password required)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@opensec-redis:6379/0

# PCAP Retention & Encryption
OPENSEC_PCAP_RETENTION_DAYS=7
OPENSEC_PCAP_MAX_UPLOAD_MB=250
OPENSEC_PCAP_ENC_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# Wireless Sensor Profile (Linux host only: --profile wireless-sensor)
OPENSEC_SENSOR_ID=sensor-linux-01
OPENSEC_WIFI_INTERFACE=wlan0mon
KISMET_HOST=127.0.0.1
KISMET_PORT=2501
KISMET_USER=opensec_kismet
KISMET_PASSWORD=CHANGE_ME_KISMET_PASSWORD

# Safety & Governance
OPENSEC_DEFAULT_MODE=passive_only
OPENSEC_KILL_SWITCH_ON_BOOT=false
